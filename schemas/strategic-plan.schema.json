{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategic Plan",
  "description": "Output schema for Phase 2 — Strategic Planning. Claude Code /plan must produce JSON matching this schema.",
  "type": "object",
  "required": ["schema_version", "feature_title", "problem_statement", "solution_overview", "tasks", "validation_commands", "rollback"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "feature_title": { "type": "string", "minLength": 5 },
    "problem_statement": { "type": "string", "minLength": 20 },
    "root_cause": { "type": "string" },
    "solution_overview": { "type": "string", "minLength": 20 },
    "lessons_consulted": {
      "type": "array",
      "description": "Lessons from previous runs that informed this plan",
      "items": {
        "type": "object",
        "required": ["lesson_id", "how_applied"],
        "properties": {
          "lesson_id": { "type": "string" },
          "pattern": { "type": "string" },
          "how_applied": { "type": "string" }
        }
      }
    },
    "architectural_decisions": {
      "type": "array",
      "description": "ADRs for medium+ risk changes",
      "items": {
        "type": "object",
        "required": ["title", "decision", "rationale"],
        "properties": {
          "title": { "type": "string" },
          "context": { "type": "string" },
          "decision": { "type": "string" },
          "alternatives_considered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["option", "rejected_because"],
              "properties": {
                "option": { "type": "string" },
                "pros": { "type": "array", "items": { "type": "string" } },
                "cons": { "type": "array", "items": { "type": "string" } },
                "rejected_because": { "type": "string" }
              }
            }
          },
          "rationale": { "type": "string" },
          "consequences": { "type": "string" },
          "decision_confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "change_class", "files_in_scope", "acceptance_criteria", "security_risk_level", "wave"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 5 },
          "description": { "type": "string" },
          "change_class": { "enum": ["hotfix", "feature", "refactor", "risky-infra"] },
          "priority": { "enum": ["P0", "P1", "P2", "P3"], "default": "P2" },
          "files_in_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "files_out_of_scope": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^task-[0-9]{3}$" } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "preventive_controls": {
            "type": "array",
            "description": "Controls derived from lessons learned, added to acceptance criteria",
            "items": { "type": "string" }
          },
          "security_risk_level": { "enum": ["low", "medium", "high", "critical"] },
          "security_notes": { "type": "string" },
          "estimated_complexity": { "enum": ["small", "medium", "large"] },
          "wave": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "validation_commands": {
      "type": "object",
      "required": ["build", "test"],
      "properties": {
        "build": { "type": "string" },
        "test": { "type": "string" },
        "lint": { "type": "string" },
        "e2e": { "type": "string" }
      }
    },
    "rollback": { "type": "string", "minLength": 5 }
  },
  "additionalProperties": false
}
